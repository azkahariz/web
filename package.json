{
  "name": "aloptama-collect",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/master-sync.test.mjs tests/auth-autosave.test.mjs tests/admin-qc.test.mjs tests/admin-products.test.mjs tests/product-dependencies.test.mjs tests/product-reference-move.test.mjs tests/product-merge.test.mjs tests/product-delete.test.mjs tests/product-merge-recommendations.test.mjs tests/product-reference-selection.test.mjs tests/ux-polish.test.mjs tests/admin-export.test.mjs tests/admin-submission-monitoring.test.mjs tests/warehouse.test.mjs tests/station-site-progress.test.mjs tests/station-runtime-master.test.mjs tests/admin-runtime-master.test.mjs tests/export-master.test.mjs tests/export-source-csv.test.mjs tests/site-subtype-family.test.mjs tests/guide-versioning.test.mjs tests/guide-search.test.mjs tests/guide-completeness.test.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "test:station-completion": "node --experimental-strip-types --test tests/station-completion-engine.test.mjs tests/station-completion-master-ui.test.mjs tests/station-completion-detail-ui.test.mjs",
    "check": "npm run lint && npm run test && npm run test:station-completion",
    "validate:master": "node scripts/sync-master.mjs --validate-only",
    "sync:master": "node scripts/sync-master.mjs",
    "sync:master:local": "node scripts/sync-master.mjs --target=local",
    "sync:master:legacy:remote": "node --env-file-if-exists=.env.local scripts/sync-master.mjs --allow-legacy-remote-import",
    "export:master:csv": "node scripts/export-master-csv.mjs",
    "export:master:csv:remote": "node --env-file-if-exists=.env.local scripts/export-master-csv.mjs --target remote",
    "export:source-csv:remote": "node --env-file-if-exists=.env.local scripts/export-source-csv-remote.mjs",
    "export:master": "npm run export:master:csv",
    "provision:station-accounts": "node --env-file-if-exists=.env.local scripts/provision-station-accounts.mjs",
    "provision:super-admin": "node --env-file-if-exists=.env.local scripts/provision-super-admin.mjs",
    "provision:super-admins": "node --env-file-if-exists=.env.local scripts/provision-super-admins.mjs",
    "verify:auth-autosave": "node --env-file-if-exists=.env.local scripts/verify-auth-autosave.mjs",
    "verify:admin-qc": "node --env-file-if-exists=.env.local scripts/verify-admin-qc.mjs",
    "verify:admin-products": "node --env-file-if-exists=.env.local scripts/verify-admin-products.mjs",
    "verify:product-usage": "node --env-file-if-exists=.env.local scripts/verify-product-usage.mjs",
    "verify:product-dependencies": "node --env-file-if-exists=.env.local scripts/verify-product-dependencies.mjs",
    "verify:product-reference-move": "node --env-file-if-exists=.env.local scripts/verify-product-reference-move.mjs",
    "verify:product-merge": "node --env-file-if-exists=.env.local scripts/verify-product-merge.mjs",
    "verify:product-delete": "node --env-file-if-exists=.env.local scripts/verify-product-delete.mjs && npm run verify:product-delete-concurrency",
    "verify:product-delete-concurrency": "node --env-file-if-exists=.env.local scripts/verify-product-delete-concurrency.mjs",
    "verify:admin-submissions": "node --env-file-if-exists=.env.local scripts/verify-admin-submissions.mjs",
    "remediate:cengkareng-awos-subtypes": "node --env-file-if-exists=.env.local scripts/remediate-cengkareng-awos-subtypes.mjs",
    "verify:cengkareng-awos-remediation": "node scripts/verify-cengkareng-awos-remediation.mjs",
    "verify:warehouse": "node scripts/verify-warehouse.mjs",
    "verify:admin-api": "node --env-file-if-exists=.env.local scripts/verify-admin-api.mjs",
    "verify:station-runtime-master": "node --experimental-strip-types scripts/verify-station-runtime-master.mjs",
    "verify:site-subtype-family": "node scripts/verify-site-subtype-family.mjs",
    "verify:station-completion": "node --env-file-if-exists=.env.local scripts/verify-station-completion.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "fflate": "^0.8.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postgres": "^3.4.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
