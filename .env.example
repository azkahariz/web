# Trusted local/server process only. Never expose this value through NEXT_PUBLIC_*.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# Browser/Vercel. Publishable key aman dipakai di client karena akses dibatasi RLS.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only untuk operasi admin runtime dan provisioning lokal.
# Tambahkan ke Vercel Preview/Production, tetapi jangan pernah gunakan prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Opsional untuk provisioning/testing Supabase lokal. Ambil dari `npx.cmd supabase status`.
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_SECRET_KEY=sb_secret_LOCAL_REPLACE_ME

# Opsional. Default script provision:super-admin adalah superadmin.
SUPER_ADMIN_USERNAME=superadmin
