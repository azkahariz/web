# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# generated deployment archives
*.tar.gz
*.tgz

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated master synchronization output
/sync-output/
/exports/

# vercel
.vercel

# typescript
next-env.d.ts
/outputs/
/work/
/private-output/
